{
  "name": "ecommerce-express-poc",
  "version": "1.0.0",
  "description": "Real-time Express.js ecommerce API with Redis, MongoDB, Jest, Supertest and PM2",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecommerce-api",
    "pm2:delete": "pm2 delete ecommerce-api",
    "pm2:logs": "pm2 logs ecommerce-api"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "redis": "^5.8.3"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "pm2": "^6.0.13",
    "supertest": "^7.1.4"
  }
}